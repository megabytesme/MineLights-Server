<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>resources\app_icon.ico</ApplicationIcon>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

	<ItemGroup>
		<None Remove="resources\app_icon.ico" />
		<None Remove="resources\x64\Interop.AuraServiceLib.dll" />
		<None Remove="resources\x64\LogitechLedEnginesWrapper.dll" />
		<None Remove="resources\x64\MysticLight_SDK_x64.dll" />
		<None Remove="resources\x64\wooting-rgb-sdk.dll" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="resources\app_icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Interop.AuraServiceLib">
			<HintPath>Interop.AuraServiceLib.dll</HintPath>
		</Reference>
	</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources\app_icon.ico" />
    <EmbeddedResource Include="resources\x64\iCUESDK.x64_2019.dll" />
    <EmbeddedResource Include="resources\x64\LogitechLedEnginesWrapper.dll" />
    <EmbeddedResource Include="resources\x64\MysticLight_SDK_x64.dll" />
    <EmbeddedResource Include="resources\x64\wooting-rgb-sdk.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Core\RGB.NET.Core.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Corsair\RGB.NET.Devices.Corsair.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Logitech\RGB.NET.Devices.Logitech.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Msi\RGB.NET.Devices.Msi.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Asus\RGB.NET.Devices.Asus.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Razer\RGB.NET.Devices.Razer.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Wooting\RGB.NET.Devices.Wooting.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.SteelSeries\RGB.NET.Devices.SteelSeries.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.Novation\RGB.NET.Devices.Novation.csproj" />
    <ProjectReference Include="third_party\RGB.NET\RGB.NET.Devices.PicoPi\RGB.NET.Devices.PicoPi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="third_party\**\*;tests\**\*" />
    <EmbeddedResource Remove="third_party\**\*;tests\**\*" />
    <None Remove="third_party\**\*;tests\**\*" />
  </ItemGroup>
</Project>
